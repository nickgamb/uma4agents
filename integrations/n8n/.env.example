# The owner's authorization server, and who the owner is.
UMA_AS_PUBLIC=https://as.example.com
UMA_AS_INTERNAL=https://as.example.com
UMA_OWNER=billing-team

# How this resource server is known to that authority. There is no client
# secret: it registers by signing with a key it publishes at its own origin,
# and the owner approves it from her portal before it can obtain a PAT.
UMA_AS_RS_CLIENT_ID=https://billing-mcp.example.com
UMA_PEP_RS_NAME=Billing workflows (n8n)

# Where agents reach the sidecar. The RFC 9728 metadata document claims this
# as the resource, and a client is required to reject a document that names
# anything else — so a value that does not match what agents actually type
# fails at discovery, which is a correct and confusing failure.
UMA_PEP_SCHEME=https
UMA_EXPECTED_AUTHORITY=billing-mcp.example.com

# A name for the realm in the WWW-Authenticate challenge.
UMA_REALM=billing

# The n8n MCP Server Trigger's production URL, and the header value its
# "Header auth" is set to. The header keeps the endpoint from being reached
# around the sidecar; it is not what authorizes agents.
UMA_PEP_UPSTREAM=http://n8n:5678/mcp/your-path
UPSTREAM_AUTH=

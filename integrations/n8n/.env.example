# The owner's authorization server, and who the owner is.
UMA_AS_PUBLIC=https://as.example.com
UMA_OWNER=billing-team

# How this resource server authenticates to that authority to obtain a PAT.
# Registered there once, as an OAuth client with scope uma_protection.
UMA_AS_RS_CLIENT_ID=n8n-billing
UMA_AS_RS_CLIENT_SECRET=

# The n8n MCP Server Trigger's production URL, and the header value its
# "Header auth" is set to. The header keeps the endpoint from being reached
# around the sidecar; it is not what authorizes agents.
UMA_PEP_UPSTREAM=http://n8n:5678/mcp/your-path
UPSTREAM_AUTH=

# Where agents reach the sidecar. Must be the public URL, because it is what
# the RFC 9728 metadata document claims as the resource, and a client is
# required to reject a document that names anything else.
UMA_PEP_PUBLIC_BASE=https://billing-mcp.example.com

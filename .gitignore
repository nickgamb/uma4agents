# Secrets and local environment
.env
*.local

# Generated TLS material and signing keys
certs/

# Key material never belongs in the tree. certs/ above covers what `make init`
# generates, but a stray pair at the repo root escaped it once: a mkcert run
# whose hostname argument came from an unquoted command substitution produced
# `version+1.pem` for DNS:version, DNS:--short, and `git add -A` swept it in.
*.pem

# Local editor and agent configuration — machine-specific, not part of the lab
.claude/

# Working material: research notes, spikes, progress (kept local, not published)
research/

# Runtime data. Anchored to the repo root: unanchored, this also matched
# site/src/data/, which silently kept the site's own source out of the
# commit — it built locally and would have failed the moment it was cloned.
/data/
**/node_modules/
__pycache__/
*.pyc
.venv/

# Upstream checkouts (pinned + fetched by make, not vendored)
aauth/upstream/

# The master screen recording — 96 MB of 1080p, kept locally as the source to
# re-encode from. screenshots/codespace-demo.mp4 is the committed version at
# 3.9 MB, which is what the docs point at.
screenshots/U4A_Codespace_Demo.mp4

# macOS
.DS_Store

# Gatsby site build artefacts
site/node_modules/
site/.cache/
site/public/

# Local secrets for a one-off test. Never committed. The patterns are
# deliberately wider than the one file that prompted them: a key that
# arrives as `tmp.anth.env` is not matched by `tmp.env`, and the whole
# point of the rule is that nobody has to remember that.
tmp.env
tmp.*.env
*.anth.env
*.env.local

# Diagram sources. The GIFs they render are committed; these are not.
tools/diagrams/
